# ── Discord Bot ──────────────────────────────────
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# ── OpenRouter AI ─────────────────────────────────
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ── WhatsApp Cloud API ────────────────────────────
# Get these from developers.facebook.com > Your App > WhatsApp > API Setup
WHATSAPP_ACCESS_TOKEN=your_whatsapp_system_access_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
WHATSAPP_VERIFY_TOKEN=hermes_secret_token   # Pick any secret string

# ── Database ──────────────────────────────────────
# Local dev: leave as default (creates hermes.db in current dir)
# Production (Render): Set to /data/hermes.db (persistent disk)
HERMES_DB_PATH=hermes.db
